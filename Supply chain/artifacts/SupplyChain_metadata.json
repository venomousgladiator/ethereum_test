		"devdoc": {
			"details": "A smart contract to manage and track items through a supply chain. It provides role-based access for different stakeholders (Producers, Distributors, Retailers) and creates a verifiable, immutable history for each item, enhancing transparency and traceability.",
			"errors": {
				"OwnableInvalidOwner(address)": [
					{
						"details": "The owner is not a valid owner account. (eg. `address(0)`)"
					}
				],
				"OwnableUnauthorizedAccount(address)": [
					{
						"details": "The caller account is not authorized to perform an operation."
					}
				]
			},
			"kind": "dev",
			"methods": {
				"constructor": {
					"details": "Sets the contract deployer as the initial owner and initializes the item counter."
				},
				"createItem(string,string)": {
					"details": "Creates a new item and registers it on the blockchain. Can only be called by an approved Producer.",
					"params": {
						"_initialLocation": "Location where the item is created.",
						"_name": "Name of the item."
					}
				},
				"getItemHistory(uint256)": {
					"details": "Returns the full, immutable history of an item.",
					"params": {
						"_id": "The ID of the item."
					},
					"returns": {
						"_0": "The array of HistoryEvent structs."
					}
				},
				"getItemSummary(uint256)": {
					"details": "Returns a high-level summary of an item.",
					"params": {
						"_id": "The ID of the item."
					},
					"returns": {
						"currentOwner": "The item's current owner.",
						"currentState": "The item's current ItemState.",
						"id": "The item's ID.",
						"name": "The item's name."
					}
				},
				"markForSale(uint256,string)": {
					"details": "A retailer marks an item as available for sale.",
					"params": {
						"_id": "The ID of the item.",
						"_location": "The retail location."
					}
				},
				"markSold(uint256,address,string)": {
					"details": "Marks an item as \"Sold\" and transfers ownership to the end consumer.",
					"params": {
						"_consumer": "The address of the consumer.",
						"_id": "The ID of the item.",
						"_location": "The point-of-sale location."
					}
				},
				"owner()": {
					"details": "Returns the address of the current owner."
				},
				"processItem(uint256,string)": {
					"details": "A distributor processes an item (e.g., roasting coffee).",
					"params": {
						"_id": "The ID of the item.",
						"_location": "The location where processing occurs."
					}
				},
				"receiveItem(uint256,string)": {
					"details": "Confirms receiving an item. Can be called by a Distributor or Retailer.",
					"params": {
						"_id": "The ID of the item.",
						"_location": "The location where the item was received."
					}
				},
				"renounceOwnership()": {
					"details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
				},
				"shipItem(uint256,address,string)": {
					"details": "Ships an item to the next stakeholder (e.g., Producer to Distributor). This transfers \"ownership\" in the DApp to the recipient.",
					"params": {
						"_id": "The ID of the item to ship.",
						"_location": "The location from which the item is being shipped.",
						"_recipient": "The address of the next stakeholder."
					}
				},
				"transferOwnership(address)": {
					"details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
				}
			},
			"title": "SupplyChain",
			"version": 1
		},
